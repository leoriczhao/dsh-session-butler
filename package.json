{
  "name": "dsh-session-butler",
  "version": "0.3.0",
  "description": "Session management for DeepSeek Harness: browse, filter, inspect, batch-manage and trash sessions across workspaces, with read-only agent tools.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "icon.svg",
  "license": "MIT",
  "author": {
    "name": "leoric",
    "url": "https://github.com/leoriczhao"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "session",
    "session-management",
    "session-butler"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/usage.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "playwright": "1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.7.2",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test",
    "test:e2e": "node --test --test-concurrency=1 e2e/composition.e2e.mjs e2e/live-ui.e2e.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "verify": "npm run typecheck && npm run clean && npm run build && npm test && npm run validate:package",
    "prepack": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoriczhao/dsh-session-butler.git"
  },
  "homepage": "https://github.com/leoriczhao/dsh-session-butler#readme",
  "bugs": {
    "url": "https://github.com/leoriczhao/dsh-session-butler/issues"
  }
}
